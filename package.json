{
  "name": "web-search-plus-plugin-v2",
  "version": "3.2.0",
  "description": "OpenClaw plugin: one clean set of source-only web tools for Routing v2 multi-provider search, research mode, canonical-source reranking, spam/mirror filtering, unified freshness and news vertical, locale defaults, and Tavily-first extraction across Serper/Google, Brave, Tavily, Exa, Querit, Linkup, Firecrawl, Parallel, SerpBase, You.com, SearXNG, and Keenable.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.22",
      "minGatewayVersion": "2026.4.23"
    },
    "build": {
      "openclawVersion": "2026.4.23",
      "pluginSdkVersion": "2026.4.23"
    },
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "index.ts",
    "extract.ts",
    "research.ts",
    "quality.ts",
    "provider-stats.ts",
    "search-locale.ts",
    "routing-config.ts",
    "runtime-config.ts",
    "openclaw.plugin.json",
    "dist/index.js",
    "bin/web-search-plus-setup.mjs",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "openclaw",
    "plugin",
    "search",
    "serper",
    "brave",
    "tavily",
    "linkup",
    "querit",
    "exa",
    "exa-deep",
    "firecrawl",
    "you",
    "searxng",
    "web-search",
    "auto-routing",
    "parallel",
    "serpbase",
    "routing-v2",
    "quality-report",
    "research-mode",
    "authority-rerank",
    "keenable",
    "freshness",
    "news-search",
    "locale",
    "spam-filtering"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robbyczgw-cla/web-search-plus-plugin"
  },
  "author": "robbyczgw-cla",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "bin": {
    "web-search-plus-setup": "./bin/web-search-plus-setup.mjs"
  }
}
