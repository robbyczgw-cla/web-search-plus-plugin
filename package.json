{
  "name": "web-search-plus-plugin-v2",
  "version": "4.0.3",
  "description": "OpenClaw-native source-only Routing v2 search and extraction across hosted providers plus an optional separately installed DonSeTch stdio provider.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --import ./test/mock-public-dns.ts --test test/*.test.ts",
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node22 --external:openclaw/* --outfile=dist/index.js"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    },
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "index.ts",
    "extract.ts",
    "research.ts",
    "span-extraction.ts",
    "provider-http.ts",
    "octen-provider.ts",
    "tinyfish-provider.ts",
    "search1api-provider.ts",
    "donsetch-provider.ts",
    "donsetch-transport.ts",
    "source-only-gate.ts",
    "quality.ts",
    "diversity.ts",
    "provider-stats.ts",
    "search-locale.ts",
    "routing-config.ts",
    "runtime-config.ts",
    "budget-preflight.ts",
    "shadow-quality.ts",
    "extract-benchmark.ts",
    "openclaw.plugin.json",
    "dist/index.js",
    "bin/web-search-plus-setup.mjs",
    "SKILL.md",
    "README.md",
    "docs/DONSETCH.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "openclaw",
    "plugin",
    "search",
    "serper",
    "brave",
    "tavily",
    "linkup",
    "querit",
    "exa",
    "firecrawl",
    "you",
    "searxng",
    "web-search",
    "auto-routing",
    "parallel",
    "serpbase",
    "routing-v2",
    "quality-report",
    "research-mode",
    "authority-rerank",
    "keenable",
    "donsetch",
    "octen",
    "tinyfish",
    "search1api",
    "freshness",
    "news-search",
    "locale",
    "spam-filtering"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robbyczgw-cla/web-search-plus-plugin"
  },
  "author": "robbyczgw-cla",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "openclaw": "2026.8.1"
  },
  "bin": {
    "web-search-plus-setup": "./bin/web-search-plus-setup.mjs"
  }
}
